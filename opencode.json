{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "{env:LLM_TOKEN}"
      },
      "models": {
        "google/gemma-4-26b-a4b": { "name": "Gemma 4 26B A4B (local)" },
        "google/gemma-4-e4b": { "name": "Gemma 4 E4B (local, fast)" },
        "qwen/qwen3-coder-30b": { "name": "Qwen3 Coder 30B (local)" }
      }
    }
  },
  "agent": {
    "architect": { "model": "lmstudio/google/gemma-4-26b-a4b" },
    "developer": { "model": "lmstudio/google/gemma-4-26b-a4b" },
    "security-qa": { "model": "lmstudio/google/gemma-4-26b-a4b" }
  }
}
